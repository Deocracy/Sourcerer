# Sourcerer Pi sidecar config (D-08: sidecar owns its own env, decoupled from Databasise install)
# Copy this file to .env and fill in the real key. .env is gitignored — never commit it.

# Copy from Databasise runtime/.env (LLM_BINDING_API_KEY) or the Cerebras dashboard.
CEREBRAS_API_KEY=

# Provider/model defaults (D-08). Resolves via getModel(PI_PROVIDER, PI_MODEL).
PI_PROVIDER=cerebras
PI_MODEL=gpt-oss-120b
