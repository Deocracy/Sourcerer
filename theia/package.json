{
  "private": true,
  "workspaces": [
    "applications/*",
    "extensions/*"
  ],
  "resolutions": {
    "@theia/cli": "1.74.1",
    "@theia/core": "1.74.1",
    "@theia/editor": "1.74.1",
    "@theia/filesystem": "1.74.1",
    "@theia/markers": "1.74.1",
    "@theia/messages": "1.74.1",
    "@theia/monaco": "1.74.1",
    "@theia/navigator": "1.74.1",
    "@theia/preferences": "1.74.1",
    "@theia/process": "1.74.1",
    "@theia/terminal": "1.74.1",
    "@theia/workspace": "1.74.1"
  },
  "engines": {
    "yarn": ">=1.7.0 <2",
    "node": ">=22"
  },
  "devDependencies": {
    "typescript": "~5.9.3",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7"
  },
  "scripts": {
    "build:extensions": "yarn --cwd extensions/branding build",
    "build": "yarn build:extensions && yarn --cwd applications/browser build",
    "start": "yarn --cwd applications/browser start"
  }
}
